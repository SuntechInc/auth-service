generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}

enum UserType {
  GLOBAL_ADMIN
  COMPANY_ADMIN
  EMPLOYEE
}

enum RoleType {
  GLOBAL
  COMPANY
}

// ---------- Models ----------

/// Escopos de domínio (para agrupar permissões por categoria)
model RoleScope {
  id   String @id @default(cuid())
  name String @unique

  // Permissões que pertencem a este escopo
  permissions Permission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("role_scopes")
}

/// Nível de acesso customizável pela empresa (ex: Enfermaria)
model AccessLevel {
  id          String   @id @default(cuid()) @map("id_access_levels")
  idCompany   String   @map("id_company")
  name        String   @map("name")
  description String?  @map("description")
  type        RoleType @default(COMPANY) @map("role_type")

  permissions RolePermission[]

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  userAccessLevels UserAccessLevel[]

  @@unique([name, idCompany])
  @@map("access_levels")
}

/// Usuário do sistema (global ou de empresa)
model User {
  id           String     @id @default(cuid()) @map("id_users")
  name         String     @map("name")
  email        String     @unique @map("email")
  password     String     @map("password")
  status       UserStatus @default(ACTIVE) @map("status")
  type         UserType   @default(EMPLOYEE) @map("user_type")
  idCompany    String?    @map("id_company")

  accessLevels      UserAccessLevel[]
  directPermissions UserPermission[]

  // Relações para tokens e sessões
  refreshTokens RefreshToken[]
  sessions      UserSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([idCompany])
  @@map("users")
}

/// Join table: Usuário ↔ Nível de Acesso
model UserAccessLevel {
  idUser        String      @map("id_user")
  idAccessLevel String      @map("id_access_level")
  user          User        @relation(fields: [idUser], references: [id])
  level         AccessLevel @relation(fields: [idAccessLevel], references: [id])

  @@id([idUser, idAccessLevel])
  @@map("user_access_levels")
}

/// Permissão base (ex: equipment.read)
model Permission {
  id          String  @id @default(cuid()) @map("id_permissions")
  name        String  @unique @map("name")
  description String? @map("description")

  // Escopo deste permissao
  scope   RoleScope @relation(fields: [scopeId], references: [id])
  scopeId String    @map("scope_id")

  roles RolePermission[]

  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  UserPermission UserPermission[]

  @@map("permissions")
}

/// Join table: Nível de Acesso ↔ Permissão
model RolePermission {
  idLevel      String      @map("id_access_level")
  idPermission String      @map("id_permission")
  level        AccessLevel @relation(fields: [idLevel], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [idPermission], references: [id], onDelete: Cascade)

  @@id([idLevel, idPermission])
  @@map("role_permissions")
}

/// Permissão atribuída diretamente ao usuário
model UserPermission {
  idUser       String     @map("id_user")
  idPermission String     @map("id_permission")
  user         User       @relation(fields: [idUser], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [idPermission], references: [id], onDelete: Cascade)

  @@id([idUser, idPermission])
  @@map("user_permissions")
}

/// Token de refresh para autenticação
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("id_user")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false) @map("revoked")

  @@map("refresh_tokens")
}

/// Blacklist de tokens JWT revogados
model TokenBlacklist {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("token_blacklist")
}

/// Sessão de login do usuário
model UserSession {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("id_user")
  ip        String?  @map("ip")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false) @map("revoked")

  @@map("user_sessions")
}
